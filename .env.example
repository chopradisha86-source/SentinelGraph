# Copy this file to .env and fill in your values.
# docker compose automatically loads .env from the project root.

# Required only for AI incident report generation (main.py's AI step,
# and app.py's on-demand "generate_report" WebSocket command).
GEMINI_API_KEY=

# Optional: tune the live WebSocket stream (app.py). Defaults shown.
STREAM_INTERVAL_SECONDS=1.0
BURST_WINDOW_SECONDS=120
BURST_THRESHOLD=5
